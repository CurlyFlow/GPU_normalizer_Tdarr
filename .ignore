!work/ffmpeg-loudnorm-oracle/*.py
!work/ffmpeg-loudnorm-oracle/*.md
!work/ffmpeg-loudnorm-oracle/*.json
!work/reference/
work/reference/**
!work/reference/*.c
!work/reference/*.h
!work/source-refs/
work/source-refs/**
!work/source-refs/ffmpeg-n7.1.2/
work/source-refs/ffmpeg-n7.1.2/**
!work/source-refs/ffmpeg-n7.1.2/libavfilter/
