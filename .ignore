# Search-only visibility overrides for OpenCode/ripgrep.
# Git publishing rules stay in .gitignore. Keep private data and artifacts hidden.
# Broad include/glob patterns can enumerate opened local parents. Keep these
# search-only exceptions local; git publishing rules stay in .gitignore.

# Local repo instructions.
!AGENTS.md

# Active editable plugin source; gitignored by the release workflow.
!src/
src/**
!src/gpuNormalizeAudio/
src/gpuNormalizeAudio/**
!src/gpuNormalizeAudio/index.js
!src/gpuNormalizeAudio/lib/
src/gpuNormalizeAudio/lib/**
!src/gpuNormalizeAudio/lib/*.js
!src/gpuNormalizeAudio/runtime/
src/gpuNormalizeAudio/runtime/**
!src/gpuNormalizeAudio/runtime/bin/
src/gpuNormalizeAudio/runtime/bin/**
!src/gpuNormalizeAudio/runtime/bin/*.py
!src/gpuNormalizeAudio/runtime/bin/*.c
!src/gpuNormalizeAudio/runtime/bin/loudnorm-gpu-source-port
!src/gpuNormalizeAudio/runtime/cuda/
src/gpuNormalizeAudio/runtime/cuda/**
!src/gpuNormalizeAudio/runtime/cuda/*.py
!src/gpuNormalizeAudio/runtime/cuda/*.cu
!src/gpuNormalizeAudio/runtime/cuda/*.cuh

# Local agent context needed for this repo.
!.agents/
.agents/**
!.agents/skills/
.agents/skills/**
!.agents/skills/SKILLS.md
!.agents/skills/tdarr-gpu-normalize-plugin/
.agents/skills/tdarr-gpu-normalize-plugin/**
!.agents/skills/tdarr-gpu-normalize-plugin/SKILL.md
!.agents/skills/tdarr-gpu-normalize-plugin/state.md
!.agents/skills/review-codebase/
.agents/skills/review-codebase/**
!.agents/skills/review-codebase/state.md

# Internal repo handoff and active plans. These are local/private, but they are
# important for understanding current Tdarr GPU Normalize work.
!docs/
docs/**
!docs/HANDOFF.md
!docs/PROFILE_SUMMARY_REFACTOR.md
!docs/active/
docs/active/**
!docs/active/*.md
!docs/tdarr-references/
docs/tdarr-references/**
!docs/tdarr-references/INDEX.md

# Tdarr skill harness, diagnostics, and parity references. These stay gitignored
# in .gitignore, but need to be searchable for local optimization/debugging.
!work/
work/**
!work/tdarr
!work/cpu_gpu_compare.js
!work/plugin_e2e_smoke.js
!work/plugin_details_smoke.js
