+static void aac_mt_twoloop_task(void *raw, int ch_idx)
+{
+    AACMtTwoloopArg *a = (AACMtTwoloopArg *)raw;
+    AACEncContext *wctx = &a->s->mt_pool->workers[ch_idx];
+
+    wctx->cur_channel = ch_idx;
+    wctx->cur_type = a->ch_tag[ch_idx];
+    wctx->lambda = a->lambda;
+    wctx->psy.bitres.alloc = a->ch_alloc[ch_idx];
+    wctx->psy.bitres.bits = a->bitres_bits;
+    wctx->psy.cutoff = a->psy_cutoff;
+    wctx->coder->search_for_quantizers(a->avctx, wctx, a->ch_sce[ch_idx], a->lambda);
+}
