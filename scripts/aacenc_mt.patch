+typedef struct AACMtWinMdctArg {
+    AVCodecContext *avctx;
+    AACEncContext *s;
+    const AVFrame *frame;
+    FFPsyWindowInfo *windows;
+    SingleChannelElement *ch_sce[AAC_MAX_CHANNELS];
+    int ch_tag[AAC_MAX_CHANNELS];
+    _Atomic int err;
+} AACMtWinMdctArg;
+
+static void aac_mt_win_mdct_task(void *raw, int ch_idx)
+{
+    AACMtWinMdctArg *a = (AACMtWinMdctArg *)raw;
+    AACEncContext *s = a->s;
+    AACEncContext *wctx = &s->mt_pool->workers[ch_idx];
+    SingleChannelElement *sce = a->ch_sce[ch_idx];
+    IndividualChannelStream *ics = &sce->ics;
+    FFPsyWindowInfo *wi = &a->windows[ch_idx];
+    int tag = a->ch_tag[ch_idx];
+    float *overlap = &s->planar_samples[ch_idx][0];
+    float *samples2 = overlap + 1024;
+    float *la = a->frame ? (samples2 + (448 + 64)) : NULL;
+    float clip_avoidance_factor;
+    int w, k;
+
+    wctx->cur_channel = ch_idx;
+    if (tag == TYPE_LFE) {
+        wi->window_type[0] = wi->window_type[1] = ONLY_LONG_SEQUENCE;
+        wi->window_shape   = 0;
+        wi->num_windows    = 1;
+        wi->grouping[0]    = 1;
+        wi->clipping[0]    = 0;
+        ics->num_swb = s->samplerate_index >= 8 ? 1 : 3;
+    } else {
+        *wi = s->psy.model->window(&s->psy, samples2, la, ch_idx,
+                                   ics->window_sequence[0]);
+    }
+    ics->window_sequence[1] = ics->window_sequence[0];
+    ics->window_sequence[0] = wi->window_type[0];
+    ics->use_kb_window[1]   = ics->use_kb_window[0];
+    ics->use_kb_window[0]   = wi->window_shape;
+    ics->num_windows        = wi->num_windows;
+    ics->swb_sizes          = s->psy.bands[ics->num_windows == 8];
+    ics->num_swb            = tag == TYPE_LFE ? ics->num_swb : s->psy.num_bands[ics->num_windows == 8];
+    ics->max_sfb            = FFMIN(ics->max_sfb, ics->num_swb);
+    ics->swb_offset         = wi->window_type[0] == EIGHT_SHORT_SEQUENCE ?
+                                ff_swb_offset_128[s->samplerate_index] :
+                                ff_swb_offset_1024[s->samplerate_index];
+    ics->tns_max_bands      = wi->window_type[0] == EIGHT_SHORT_SEQUENCE ?
+                                ff_tns_max_bands_128[s->samplerate_index] :
+                                ff_tns_max_bands_1024[s->samplerate_index];
+
+    for (w = 0; w < ics->num_windows; w++)
+        ics->group_len[w] = wi->grouping[w];
+
+    clip_avoidance_factor = 0.0f;
+    for (w = 0; w < ics->num_windows; w++) {
+        const float *wbuf = overlap + w * 128;
+        const int wlen = 2048 / ics->num_windows;
+        float max = 0;
+        int j;
+        for (j = 0; j < wlen; j++)
+            max = FFMAX(max, fabsf(wbuf[j]));
+        wi->clipping[w] = max;
+    }
+    for (w = 0; w < ics->num_windows; w++) {
+        if (wi->clipping[w] > CLIP_AVOIDANCE_FACTOR) {
+            ics->window_clipping[w] = 1;
+            clip_avoidance_factor = FFMAX(clip_avoidance_factor, wi->clipping[w]);
+        } else {
+            ics->window_clipping[w] = 0;
+        }
+    }
+    if (clip_avoidance_factor > CLIP_AVOIDANCE_FACTOR) {
+        ics->clip_avoidance_factor = CLIP_AVOIDANCE_FACTOR / clip_avoidance_factor;
+    } else {
+        ics->clip_avoidance_factor = 1.0f;
+    }
+
+    apply_window_and_mdct(wctx, sce, overlap);
+
+    for (k = 0; k < 1024; k++) {
+        if (!(fabs(sce->coeffs[k]) < 1E16)) {
+            atomic_store_explicit(&a->err, AVERROR(EINVAL), memory_order_relaxed);
+            return;
+        }
+    }
+    avoid_clipping(wctx, sce);
+}
