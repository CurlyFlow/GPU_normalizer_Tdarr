#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

dashboard_wrapper="${DASHBOARD_WRAPPER:-$repo_root/../../wrapper}"
if [[ -f tools/wrapper-project.json ]]; then
  "$dashboard_wrapper" project check normalizer_gpu_tdarr --gate # WRAP-GATE-001
fi

exec "$repo_root/scripts/quality-owner"
