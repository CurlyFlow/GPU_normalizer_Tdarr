#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

if [[ ${QUALITY_SERIAL:-0} != 1 && -f "$repo_root/tools/wrapper-quality-runner.mjs" && -f "$repo_root/../../tools/wrapper/scheduler.mjs" ]]; then
  exec node "$repo_root/tools/wrapper-quality-runner.mjs"
fi

mapfile -t release_roots < <(
  for base in FlowPlugins/LocalFlowPlugins/audio/gpuNormalizeAudio FlowPlugins/CommunityFlowPlugins/audio/gpuNormalizeAudio; do
    [[ -d "$base" ]] || continue
    for dir in "$base"/*; do
      [[ -d "$dir" ]] || continue
      printf '%s\t%s\n' "$(basename "$dir")" "$dir"
    done
  done | sort -k1,1V | cut -f2
)
if [[ ${#release_roots[@]} -eq 0 || ! -d "${release_roots[-1]}" ]]; then
  printf 'No tracked GPU Normalize Audio release snapshot found.\n' >&2
  exit 1
fi

targets=("${release_roots[-1]}")
if [[ ${QUALITY_SKIP_LOCAL_SOURCE:-0} != 1 && -d src/gpuNormalizeAudio ]]; then
  targets+=(src/gpuNormalizeAudio)
fi

printf 'quality: lint\n'
npx eslint "${targets[@]}" scripts/quality-contracts.test.js scripts/generate_pictures.js
if [[ -d work/compare ]]; then
  npx eslint work/compare work/cpu_gpu_compare.js work/compare-self-test.js
fi

printf 'quality: source structure\n'
if [[ -d tools ]]; then
  python3 scripts/source-quality.py tools
fi
if [[ -f src/mediaPipelineHelper/runtime/bin/tdarr_media_names.py ]]; then
  python3 scripts/source-quality.py src/mediaPipelineHelper/runtime/bin/tdarr_media_names.py src/mediaPipelineHelper/runtime/bin/media_*.py work/media_*.py work/test_tdarr_media_names.py work/test_media_*.py
fi
SOURCE_QUALITY_MAX_LINES=1500 SOURCE_QUALITY_MAX_COMPLEXITY=150 python3 scripts/source-quality.py "${targets[0]}"
if [[ ${#targets[@]} -gt 1 ]]; then
  python3 scripts/source-quality.py "${targets[1]}" scripts
else
  python3 scripts/source-quality.py scripts
fi
if [[ -d work/tdarr.d ]]; then
  python3 scripts/source-quality.py work/tdarr.d
fi
if [[ -d work/compare ]]; then
  python3 scripts/source-quality.py work/compare work/cpu_gpu_compare.js work/compare-self-test.js
fi

printf 'quality: architecture\n'
for target in "${targets[@]}"; do
  npx depcruise "$target" --config .dependency-cruiser.cjs --output-type err
done
if [[ -d work/compare ]]; then
  npx depcruise work/cpu_gpu_compare.js --config .dependency-cruiser.cjs --output-type err
fi

printf 'quality: duplication\n'
for target in "${targets[@]}"; do
  npx jscpd "$target" --no-gitignore --format javascript --min-lines 10 --min-tokens 80 --threshold 0 --ignore '**/runtime/**,**/FlowHelpers/**' --noTips
  npx jscpd "$target/runtime" --no-gitignore --format python,c,bash --min-lines 30 --min-tokens 250 --threshold 0 --ignore '**/*.ptx,**/*.so' --noTips
  npx jscpd "$target/runtime/cuda" --no-gitignore --min-lines 180 --min-tokens 2500 --threshold 0 --ignore '**/*.ptx' --formats-exts 'cpp:cu,cuh' --noTips
done
npx jscpd scripts --no-gitignore --format python,bash --min-lines 20 --min-tokens 150 --threshold 0 --noTips
if [[ -d work/tdarr.d ]]; then
  npx jscpd work/tdarr.d --no-gitignore --format python,bash --min-lines 20 --min-tokens 150 --threshold 0 --noTips
fi

printf 'quality: shell syntax\n'
shell_files=(scripts/quality-check scripts/quality-owner)
[[ -f install.sh ]] && shell_files+=(install.sh)
[[ -f work/tdarr ]] && shell_files+=(work/tdarr)
for shell_file in work/tdarr.d/*.sh; do
  [[ -f "$shell_file" ]] && shell_files+=("$shell_file")
done
bash -n "${shell_files[@]}"

if [[ -f src/gpuNormalizeAudio/runtime/bin/cuda_abi_validation.py ]]; then
  printf 'quality: CUDA ABI ownership\n'
  python3 src/gpuNormalizeAudio/runtime/bin/cuda_abi_validation.py
fi

if [[ ${QUALITY_SKIP_LOCAL_SOURCE:-0} != 1 && -f scripts/generate_pictures.js ]]; then
  printf 'quality: pictures\n'
  node scripts/generate_pictures.js --check
fi

printf 'quality: ownership contracts\n'
mkdir -p work
node --test scripts/quality-contracts.test.js
if [[ ${QUALITY_SKIP_LOCAL_SOURCE:-0} != 1 && -f work/audio-rejection.test.mjs ]]; then
  node --test work/audio-rejection.test.mjs work/mp4-chapter.test.mjs work/pipeline-lifecycle.test.mjs work/pipeline-media.test.mjs work/measurement-store.test.mjs
fi
